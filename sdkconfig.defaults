# ──────────────────────────────────────────────────────────────
# What the Strux APPLICATION needs of whatever platform it runs on.
#
# Nothing here may be a property of a particular board. The test is whether the
# line would still be true on a board nobody has built yet: WebSocket support and
# a socket budget are the application's, while flash size, flash timing and the
# partition layout are the hardware's and live in
# main/hardware/boards/<board>/sdkconfig.defaults, which every board has.
#
# That is not a filing preference, it is what keeps the drift guard honest. Flash
# size and partition-table selection are Kconfig CHOICEs: a board picking another
# arm sets a DIFFERENT symbol, so a line here would not be overridden by that
# board, it would be FALSIFIED — and the guard would correctly stop a tree that
# was configured exactly as asked. See the guard in the root CMakeLists.
#
# What the application does require of a board's table, and what a new board's
# partitions.csv therefore has to provide: an `nvs` partition (settings, WiFi
# credentials, auth), `otadata` and `phy_init`, and TWO app slots large enough
# for the image — the frontend is linked into it, and `partition activate` is
# what makes an upload bootable. Sizes are the board's business; their existence
# is not.
# ──────────────────────────────────────────────────────────────

# HTTP server WebSocket support
CONFIG_HTTPD_WS_SUPPORT=y

# Increase timer task stack (default 2048 too small for WiFi calls in timer callbacks)
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# OTA rollback — pairs with esp_ota_mark_app_valid_cancel_rollback() in main.cpp
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Dynamic frequency scaling (CONFIG_PM_ENABLE + PM_DFS_INIT_AUTO): DELIBERATELY OFF.
#
# Strux turned it on, so the CPU idled at the XTAL frequency (40 MHz on a C3) whenever
# no task held a power-management lock. On the ESP32-C3 that is not a few microseconds
# of interrupt latency, it is a station that drops what it receives: on 2026-10-08 the
# SuperMini associated and completed the WPA2 handshake every time, at -66 dBm, and
# then never got a DHCP answer -- three 15 s rounds, no address. Compiling PM out, one
# variable, gave an address 1.6 s after association. DPS50xx measured the same thing
# on 2026-09-10 (ICMP loss 45 % -> 0 %, command median 3925 ms -> 72 ms) and reads it
# as the RX path falling behind at a quarter clock, not as slow arithmetic.
#
# Tracked upstream as vanBassum/Strux#59. A Wavy is mains-powered and drives a signal
# generator; there is nothing to save. LedcSquareWave's PM lock stays and is inert:
# esp_pm_lock_create fails without CONFIG_PM_ENABLE and the driver skips it.
#
# Nothing is asserted here, because the drift guard reads only KEY=value lines and
# Kconfig's default is already off. A tree generated before this change still records
# CONFIG_PM_ENABLE=y and keeps it: delete that sdkconfig and re-run set-target.

# lwIP socket budget, and the reason it cannot stay at IDF's default of 10.
#
# esp_http_server reserves 3 sockets for itself on top of `max_open_sockets`, whose
# default is 7, and it refuses to start if LWIP_MAX_SOCKETS < max_open_sockets + 3.
# At the default of 10 that inequality is exactly tight: the web server is entitled
# to the WHOLE budget, and every other socket on the device — the relay's outbound
# WebSocket, mDNS, SNTP, the DHCP client — is competing for sockets httpd has already
# claimed. `accept()` then fails with errno 23 (ENFILE) and the server RESETS whichever
# connections lose the race.
#
# That stayed invisible while a page load asked for two files. It stopped being
# invisible when the UI briefly shipped as separate module bundles behind an import
# map: four concurrent requests plus the command WebSocket, and the browser silently
# lost the stylesheet, so the page came up with no CSS at all. Nothing in the UI could
# say why — the only evidence was `httpd_accept_conn: error in accept (23)` in the
# device log.
#
# The frontend is one bundle again, so a page load is back to three requests and this
# would no longer bite. The setting stays at 16 anyway — the option's maximum — because
# the inequality was always too tight: httpd's 7 + 3 against a budget of 10 leaves
# nothing for the relay's outbound socket, mDNS, SNTP or DHCP. A fork that adds a
# second listener should read this before trusting the default again.
CONFIG_LWIP_MAX_SOCKETS=16
